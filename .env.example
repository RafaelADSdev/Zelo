GEMINI_API_KEY=coloque_sua_chave_aqui
GEMINI_MODEL=gemini-2.5-flash
# Configure o WhatsApp e substitua chaves pelo painel local, em Conexões.
# A configuração salva no painel tem prioridade nas próximas inicializações.
PORT=4173
WEBHOOK_PORT=4174

# Servidor apenas. Nunca colocar a chave secreta no navegador.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_BACKUP_KEY=

# Somente no servidor / Production da Vercel. Não usar prefixo PUBLIC ou VITE.
ZELO_PUBLIC_ORIGIN=https://seu-projeto.vercel.app
# Código aleatório de 64 caracteres hexadecimais para criar o primeiro administrador.
ZELO_SETUP_TOKEN=
