      "css": ".ds-label{display:block;margin:19px 0 8px;font:600 12px/1.55 'Segoe UI',Arial,sans-serif;color:#48414f}.ds-field{width:100%;min-width:0;max-width:100%;font:13px/1.5 'Segoe UI',Arial,sans-serif;padding:11px 13px;border:1px solid #ddd8e5;border-radius:9px;background:#fff;color:var(--text,#202028);caret-color:var(--accent,#7041db);transition:border-color .16s}.ds-field:hover{border-color:#bdb4ca}.ds-field:focus{border-color:#9870d3}.ds-field:focus-visible{outline:3px solid #b89aef;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-field{transition:none}}"
