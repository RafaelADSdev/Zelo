      "css": ".ds-switch{position:relative;display:block;width:42px;height:26px;cursor:pointer}.ds-switch input{position:absolute;opacity:0;width:42px;height:26px;margin:0;z-index:1;cursor:pointer}.ds-switch span{display:block;background:#b8b0c1;border-radius:16px;height:26px;transition:background-color .18s}.ds-switch span:after{content:'';position:absolute;top:4px;left:4px;width:18px;height:18px;background:#fff;border-radius:50%;box-shadow:0 1px 3px #29202f20;transition:transform .18s}.ds-switch input:checked+span{background:var(--accent,#7041db)}.ds-switch input:checked+span:after{transform:translateX(16px)}.ds-switch input:focus-visible+span{outline:3px solid #b89aef;outline-offset:4px}.ds-switch input:disabled{cursor:wait}@media(prefers-reduced-motion:reduce){.ds-switch span,.ds-switch span:after{transition:none}}"
