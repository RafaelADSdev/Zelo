  "narrative": {
    "northStar": "Restrained functional workspace",
    "overview": "This scoped record describes the shipped Conexões e IA surface, extracted from `public/panel.css`, inherited primitives in `public/style.css`, structure in `public/index.html`, and behavior in `public/ai-keys.js` and `public/settings-ui.js`. The local direction contract supplies its descriptive language; this is a code-led refinement with no approved comp.\n\nPurple, white and near-black maintain the Zelo identity. Aligned connection rows, compact metadata, explicit statuses and progressively disclosed secondary actions support configuration work. This record does not reconcile the older project-wide Wappy documentation. All seven supported providers use local Lobe Icons SVG marks with provenance and MIT license in public/brand/providers/README.md; adjacent provider names carry accessible identity. Contact rows reserve 58px of left padding for avatars and truncate long names and workspace email. Native activity disclosure presents a count badge and separate message/event sections with an empty-event state. A compact privacy disclosure sits beside a separate logout action; short desktop sidebars compact spacing and scroll vertically.",
    "keyCharacteristics": [
      "White bordered panels on a pale neutral canvas.",
      "Purple selections and primary actions with explicit text states.",
      "Ordered rows that become stacked groups on small screens.",
      "Native controls and disclosures with visible keyboard focus."
    ],
    "rules": [
      {
        "body": "Availability, validation, waiting, errors and connection state appear as explicit labels; a dot or tint alone is insufficient.",
        "name": "The State Has Words Rule",
        "section": "colors"
      },
      {
        "body": "Small screens retain priority, identity, state and actions together by stacking them in reading order.",
        "name": "The Row Becomes a Group Rule",
        "section": "layout"
      }
    ],
    "dos": [
      "**Do** retain purple actions, white panels and near-black headings within settings.",
      "**Do** pair operational statuses with readable labels.",
      "**Do** preserve linked labels, visible focus, keyboard tab navigation and native disclosures.",
      "**Do** stack row content and actions together on small screens and wrap long identifiers.",
      "**Do** use SVG action icons with accessible control names."
    ],
    "donts": [
      "**Don't** imply successful validation from availability or next-use position.",
      "**Don't** give destructive or uncommon actions the same visual prominence as edit and save.",
      "**Don't** apply this scoped refinement as a replacement identity for unrelated surfaces."
    ]
  }
