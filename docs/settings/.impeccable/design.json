      "css": ".ds-card{font-family:'Segoe UI',Arial,sans-serif;padding:28px 30px;border:1px solid var(--settings-line,#e8e5ed);border-radius:16px;background:#fff}.ds-card h2{font-size:21px;font-weight:650;line-height:1.3;letter-spacing:-.55px;color:var(--settings-ink,#24202b);margin:0 0 7px}.ds-card p{font-size:13px;line-height:1.7;color:var(--settings-muted,#706979);max-width:64ch;margin:0}@media(max-width:800px){.ds-card{padding:24px}.ds-card h2{font-size:20px}}@media(max-width:580px){.ds-card{padding:20px 17px;border-radius:13px}.ds-card p{font-size:12px}}"
